{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rc-atlas.local/qa/hypothesis.schema.json",
  "title": "RC Atlas QA hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hypothesis_id", "audit_id", "baseline_commit_sha", "owner", "scenario_ids", "observation", "uncertainty", "required_confirmation", "evidence_refs", "confidence"],
  "properties": {
    "schema_version": {"const": 1},
    "hypothesis_id": {"type": "string", "pattern": "^HYP-[A-Z0-9._-]+$"},
    "audit_id": {"type": "string"},
    "baseline_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "owner": {"type": "string"},
    "scenario_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "observation": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "string", "minLength": 1},
    "required_confirmation": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "NONE"]}
  }
}
