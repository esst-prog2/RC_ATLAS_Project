{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rc-atlas.local/qa/audit-execution-plan.schema.json",
  "title": "RC Atlas QA audit execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "baseline_commit_sha", "lead_owner", "authorization", "source_snapshot", "execution", "safety"],
  "properties": {
    "schema_version": {"const": 1},
    "audit_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{7,127}$"},
    "baseline_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "lead_owner": {"const": "qa_lead"},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "source_only", "authorized_by"],
      "properties": {
        "phase": {"type": "string", "minLength": 1},
        "source_only": {"const": true},
        "authorized_by": {"type": "string", "minLength": 1}
      }
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "metadata_file", "baseline_commit_sha", "verified"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "metadata_file": {"type": "string", "minLength": 1},
        "baseline_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "verified": {"const": true}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "runtime_id", "process_policy", "ports", "specialist_assignments"],
      "properties": {
        "mode": {"enum": ["codex_subagents", "sequential_roles"]},
        "runtime_id": {"type": "null"},
        "process_policy": {"const": "no_processes"},
        "ports": {"type": "array", "maxItems": 0},
        "specialist_assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["specialist_role", "agent_id", "scenario_ids", "verification_mode"],
            "properties": {
              "specialist_role": {"enum": ["functional", "integration", "data_analytics", "ui_ux", "security_access", "reliability"]},
              "agent_id": {"type": ["string", "null"]},
              "scenario_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
              "verification_mode": {"const": "source_inspection"}
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_checkout_reference_prohibited", "runtime_access", "network_access", "protected_resource_access"],
      "properties": {
        "original_checkout_reference_prohibited": {"const": true},
        "runtime_access": {"const": "prohibited"},
        "network_access": {"const": "prohibited"},
        "protected_resource_access": {"const": "prohibited"}
      }
    }
  }
}
